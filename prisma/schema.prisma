// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HOSPITAL
  DONOR
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum RequestStatus {
  PENDING
  VERIFIED
  MATCHED
  FULFILLED
  CANCELLED
}

enum DonationStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum HospitalType {
  GOVERNMENT
  PRIVATE
  CLINIC
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  role          Role     @default(DONOR)
  isVolunteer   Boolean  @default(false)
  isBanned      Boolean  @default(false)
  oauthProvider String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  donorProfile  DonorProfile?
  hospital      Hospital?
  requests      BloodRequest[] @relation("RequesterUser")
  notifications Notification[]
  payments      Payment[]
  auditLogs     AuditLog[]
}

model DonorProfile {
  id             String     @id @default(uuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodGroup     BloodGroup
  lastDonationAt DateTime?
  isAvailable    Boolean    @default(true)
  lat            Float?
  lng            Float?
  photoUrl       String?
  deletedAt      DateTime?

  donations Donation[]

  @@index([bloodGroup])
  @@index([isAvailable])
  @@index([deletedAt])
}

model Hospital {
  id                  String             @id @default(uuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  address             String
  type                HospitalType?
  email               String?
  district            String?
  upazila             String?
  phone               String?
  emergencyPhone      String?
  website             String?
  logoUrl             String?
  openHours           String?
  hasEmergencyService Boolean            @default(false)
  description         String?
  licenseNumber       String?
  verificationStatus  VerificationStatus @default(PENDING)
  licenseDocUrl       String?
  deletedAt           DateTime?

  @@index([district])
  @@index([verificationStatus])
  @@index([deletedAt])
}

model BloodRequest {
  id          String        @id @default(uuid())
  requesterId String
  requester   User          @relation("RequesterUser", fields: [requesterId], references: [id])
  bloodGroup  BloodGroup
  unitsNeeded Int
  urgency     Int           @default(1)
  status      RequestStatus @default(PENDING)
  lat         Float?
  lng         Float?
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  donation      Donation?
  notifications Notification[]
  payments      Payment[]

  @@index([bloodGroup])
  @@index([status])
  @@index([deletedAt])
}

model Donation {
  id          String         @id @default(uuid())
  donorId     String
  donor       DonorProfile   @relation(fields: [donorId], references: [id])
  requestId   String         @unique
  request     BloodRequest   @relation(fields: [requestId], references: [id])
  scheduledAt DateTime?
  completedAt DateTime?
  status      DonationStatus @default(SCHEDULED)

  @@index([donorId])
}

model Notification {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String?
  request   BloodRequest? @relation(fields: [requestId], references: [id])
  channel   String
  /// What happened, e.g. REQUEST_MATCH, DONOR_ACCEPTED, REQUEST_FULFILLED.
  type      String        @default("REQUEST_MATCH")
  title     String        @default("")
  message   String        @default("")
  /// Where the bell sends the user when they click it.
  link      String?
  sentAt    DateTime      @default(now())
  readAt    DateTime?

  @@index([userId])
}

model Payment {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  requestId  String?
  request    BloodRequest? @relation(fields: [requestId], references: [id])
  amount     Float
  currency   String        @default("usd")
  gatewayRef String?       @unique
  purpose    String
  status     PaymentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
